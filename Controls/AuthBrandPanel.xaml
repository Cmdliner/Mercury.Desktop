<UserControl x:Class="Mercury.Desktop.Controls.AuthBrandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls">

    <!-- The dark side of the sign-in and invitation screens: the glass texture, the bead and the pitch. -->
    <Grid Background="{StaticResource Brush.Sidebar}" ClipToBounds="True">
        <Border Opacity="0.32">
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Resources/Images/glass.jpg" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <controls:BeadIllustration Width="300" Height="225" Margin="0,0,-40,-30"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource Brush.SidebarForeground}" Opacity="0.5" />
        <StackPanel MaxWidth="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource Font.SemiBold}"
                       FontSize="40"
                       Foreground="{StaticResource Brush.SidebarForeground}"
                       Text="One set of books."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="16"
                       Foreground="{StaticResource Brush.SidebarMuted}"
                       Text="Every store keeps its own accounts and ledger. Mercury brings them together, so you can see where the money is at a glance."
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
