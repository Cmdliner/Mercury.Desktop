<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mercury.Desktop;component/Resources/Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        Buttons. Square corners, black and white, like the website.

        Variants:  Button.Primary (also the default for every Button), Button.Outline,
                   Button.Secondary, Button.Ghost, Button.Icon
        Sizes:     40px by default; add ".Lg" (48px) for the main action of a screen,
                   for example Style="{StaticResource Button.Primary.Lg}".
    -->

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.None}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ring}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: solid black. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryForeground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.PrimaryHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ring}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Outline: black border that fills on hover. -->
    <Style x:Key="Button.Outline" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Foreground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryForeground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ring}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary: soft grey fill, for quieter actions. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Secondary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SecondaryHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ring}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost: no fill until hover, for tertiary actions such as Back. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedForeground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Secondary}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ring}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon: a square ghost button for a single icon, for example a close button. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Large (48px) versions for the main action of a screen. -->
    <Style x:Key="Button.Primary.Lg" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.ControlLg}" />
        <Setter Property="Padding" Value="{StaticResource Padding.ControlLg}" />
    </Style>

    <Style x:Key="Button.Outline.Lg" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
        <Setter Property="Height" Value="{StaticResource Size.ControlLg}" />
        <Setter Property="Padding" Value="{StaticResource Padding.ControlLg}" />
    </Style>

    <Style x:Key="Button.Ghost.Lg" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Height" Value="{StaticResource Size.ControlLg}" />
        <Setter Property="Padding" Value="{StaticResource Padding.ControlLg}" />
    </Style>

    <!-- Every Button is Primary unless it says otherwise. -->
    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}" />
</ResourceDictionary>
