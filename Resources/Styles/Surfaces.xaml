<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mercury.Desktop;component/Resources/Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        Surfaces. Depth comes from tone and a 1px border, never from drop shadows.
    -->

    <!-- Card: a white raised panel on the warm page background. -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.2Xl}" />
        <Setter Property="Padding" Value="32" />
    </Style>

    <!-- A thin horizontal rule. -->
    <Style x:Key="Surface.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
    </Style>

    <!-- Avatar: a black circle for initials. Size it with Width and Height; the text style is Text.Avatar. -->
    <Style x:Key="Surface.Avatar" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.PrimaryForeground}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="TextElement.FontSize" Value="12" />
    </Style>

    <!-- Status pills: use Pill.Success for Active/Reconciled, Pill.Caution for warnings. -->
    <Style x:Key="Pill.Success" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Success}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Caption}" />
    </Style>

    <Style x:Key="Pill.Caution" TargetType="Border" BasedOn="{StaticResource Pill.Success}">
        <Setter Property="Background" Value="{StaticResource Brush.SunSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.SunInk}" />
    </Style>

    <!-- A whole table row that can be clicked: a hairline above it and a soft hover. -->
    <Style x:Key="Button.TableRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row"
                            Padding="0,18"
                            Background="Transparent"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button that shows its content with no chrome, for clickable cards. -->
    <Style x:Key="Button.Plain" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
