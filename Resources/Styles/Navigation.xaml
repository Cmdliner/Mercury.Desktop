<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mercury.Desktop.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mercury.Desktop;component/Resources/Tokens/Tokens.xaml" />
        <ResourceDictionary Source="/Mercury.Desktop;component/Resources/Styles/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Sidebar navigation: a ListBox whose items look like Mercury nav rows. The selected row
        fills black. Each item needs a Title and an Icon (a geometry); see NavItemViewModel.
        Apply with Style="{StaticResource ListBox.Navigation}".
    -->
    <Style x:Key="ListBoxItem.Navigation" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row"
                            Height="40"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.None}">
                        <StackPanel Margin="14,0" Orientation="Horizontal">
                            <controls:Icon Width="18"
                                           Height="18"
                                           VerticalAlignment="Center"
                                           Data="{Binding IconKey, Converter={StaticResource Converter.Icon}}"
                                           Foreground="{TemplateBinding Foreground}"
                                           StrokeThickness="1.8" />
                            <TextBlock x:Name="Title"
                                       Margin="14,0,0,1"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Medium}"
                                       FontSize="14"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{Binding Title}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Icons only when the sidebar is collapsed; the name moves into a tooltip. -->
                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=False}" Value="True">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Row" Property="ToolTip" Value="{Binding Title}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Secondary}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBox.Navigation" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItem.Navigation}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
