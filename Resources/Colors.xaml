<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="MercuryBlack">#111111</Color>
    <Color x:Key="MercuryWhite">#FFFFFF</Color>
    <Color x:Key="MercuryText">#171717</Color>
    <Color x:Key="MercuryMuted">#737373</Color>
    <Color x:Key="MercuryBorder">#E5E5E5</Color>
    <Color x:Key="MercurySurface">#F9F9F6</Color>
    
    
    <SolidColorBrush x:Key="MercuryBlackBrush" Color="{StaticResource MercuryBlack}" />
    <SolidColorBrush x:Key="MercuryWhiteBrush"  Color="{StaticResource MercuryWhite}"/>
    <SolidColorBrush x:Key="MercuryTextBrush" Color="{StaticResource MercuryText}" />
    <SolidColorBrush x:Key="MercuryMutedBrush" Color="{StaticResource MercuryMuted}"/>
    <SolidColorBrush x:Key="MercuryBorderBrush" Color="{StaticResource MercuryBorder}" />
    <SolidColorBrush x:Key="MercurySurfaceBrush"  Color="{StaticResource MercurySurface}"/>
</ResourceDictionary>