<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icons are stroked outlines drawn on a 24 x 24 grid in the manner of the lucide set the
        website uses. Show one with <controls:Icon Data="{StaticResource Icon.Check}" />; it
        takes its colour from Foreground.
    -->
    <Geometry x:Key="Icon.Check">M 4,12.5 L 9.5,18 L 20,6.5</Geometry>
    <Geometry x:Key="Icon.ArrowRight">M 5,12 H 19 M 13,6 L 19,12 L 13,18</Geometry>
    <Geometry x:Key="Icon.ArrowLeft">M 19,12 H 5 M 11,6 L 5,12 L 11,18</Geometry>
    <Geometry x:Key="Icon.Close">M 6,6 L 18,18 M 18,6 L 6,18</Geometry>
    <Geometry x:Key="Icon.ChevronDown">M 6,9 L 12,15 L 18,9</Geometry>
    <Geometry x:Key="Icon.Eye">M 2,12 C 5,6 9,4.5 12,4.5 C 15,4.5 19,6 22,12 C 19,18 15,19.5 12,19.5 C 9,19.5 5,18 2,12 Z M 15,12 A 3,3 0 1 1 9,12 A 3,3 0 1 1 15,12 Z</Geometry>
    <Geometry x:Key="Icon.Store">M 4,9 L 5.5,4 H 18.5 L 20,9 M 4,9 H 20 M 5,9 V 20 H 19 V 9 M 9.5,20 V 14 H 14.5 V 20</Geometry>

    <!-- Navigation and actions -->
    <Geometry x:Key="Icon.Grid">M 4,4 H 10 V 10 H 4 Z M 14,4 H 20 V 10 H 14 Z M 4,14 H 10 V 20 H 4 Z M 14,14 H 20 V 20 H 14 Z</Geometry>
    <Geometry x:Key="Icon.Transfer">M 4,8 H 20 M 16,4 L 20,8 L 16,12 M 20,16 H 4 M 8,12 L 4,16 L 8,20</Geometry>
    <Geometry x:Key="Icon.Wallet">M 3,6 H 21 V 18 H 3 Z M 3,10 H 21 M 7,15 H 10</Geometry>
    <Geometry x:Key="Icon.Users">M 9,11 A 3.5,3.5 0 1 0 9,4 A 3.5,3.5 0 1 0 9,11 Z M 2.5,20 C 2.5,16.5 5.5,14.5 9,14.5 C 12.5,14.5 15.5,16.5 15.5,20 M 16,4.5 A 3.2,3.2 0 0 1 16,10.5 M 18,14.8 C 20,15.6 21.5,17.4 21.5,20</Geometry>
    <Geometry x:Key="Icon.Sidebar">M 5,4 L 19,4 A 2,2 0 0 1 21,6 L 21,18 A 2,2 0 0 1 19,20 L 5,20 A 2,2 0 0 1 3,18 L 3,6 A 2,2 0 0 1 5,4 Z M 9,4 L 9,20</Geometry>
    <Geometry x:Key="Icon.Plus">M 12,5 L 12,19 M 5,12 L 19,12</Geometry>
    <Geometry x:Key="Icon.Copy">M 9,9 L 19,9 L 19,19 L 9,19 Z M 5,15 L 5,5 L 15,5</Geometry>
    <Geometry x:Key="Icon.Payments">M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 4,20 L 20,20</Geometry>
    <Geometry x:Key="Icon.EyeOff">M 2,12 C 5,6 9,4.5 12,4.5 C 15,4.5 19,6 22,12 C 19,18 15,19.5 12,19.5 C 9,19.5 5,18 2,12 Z M 4,20 L 20,4</Geometry>
    <Geometry x:Key="Icon.ChevronRight">M 9,6 L 15,12 L 9,18</Geometry>
    <Geometry x:Key="Icon.Search">M 11,18 A 7,7 0 1 0 11,4 A 7,7 0 1 0 11,18 Z M 20,20 L 16,16</Geometry>

    <!-- Window caption buttons -->
    <Geometry x:Key="Icon.Minimize">M 6,12 H 18</Geometry>
    <Geometry x:Key="Icon.Maximize">M 6,6 H 18 V 18 H 6 Z</Geometry>
    <Geometry x:Key="Icon.Restore">M 9,6 H 18 V 15 M 6,9 H 15 V 18 H 6 Z</Geometry>
</ResourceDictionary>
