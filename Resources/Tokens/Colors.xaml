<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colour tokens. These mirror the website design system (app/globals.css) so the
        desktop app and the website look like one product. Use the Brush.* keys in views;
        never hard-code a hex value in a view or style.
    -->

    <!-- Surfaces -->
    <Color x:Key="Color.Background">#F9F9F5</Color>
    <Color x:Key="Color.SurfaceMuted">#F1F1EC</Color>
    <Color x:Key="Color.Card">#FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="Color.Foreground">#0F0F0F</Color>
    <Color x:Key="Color.MutedForeground">#5F5F59</Color>
    <Color x:Key="Color.SubtleForeground">#6C6C66</Color>

    <!-- Lines -->
    <Color x:Key="Color.Border">#E6E6E1</Color>
    <Color x:Key="Color.BorderStrong">#C5C5BC</Color>
    <Color x:Key="Color.Input">#DCDCD5</Color>
    <Color x:Key="Color.Ring">#8D8D86</Color>

    <!-- Actions -->
    <Color x:Key="Color.Primary">#0F0F0F</Color>
    <Color x:Key="Color.PrimaryHover">#2B2B2A</Color>
    <Color x:Key="Color.PrimaryForeground">#F9F9F5</Color>
    <Color x:Key="Color.Secondary">#EFEFE9</Color>
    <Color x:Key="Color.SecondaryHover">#E6E6DF</Color>

    <!-- Status: meaning, never decoration. Green is success only; amber is caution. -->
    <Color x:Key="Color.Success">#2B7A4F</Color>
    <Color x:Key="Color.SuccessSoft">#E1F0E7</Color>
    <Color x:Key="Color.Sun">#E0962B</Color>
    <Color x:Key="Color.SunSoft">#FBECD0</Color>
    <Color x:Key="Color.SunInk">#8A5A0C</Color>
    <Color x:Key="Color.Destructive">#B3261E</Color>
    <Color x:Key="Color.DestructiveSoft">#FBE9E7</Color>

    <!-- Dark sidebar (the onboarding stepper) -->
    <Color x:Key="Color.Sidebar">#0A0A0A</Color>
    <Color x:Key="Color.SidebarForeground">#F9F9F5</Color>
    <Color x:Key="Color.SidebarMuted">#A8A8A1</Color>
    <Color x:Key="Color.SidebarStep">#2A2A29</Color>
    <Color x:Key="Color.SidebarBorder">#262625</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />

    <SolidColorBrush x:Key="Brush.Foreground" Color="{StaticResource Color.Foreground}" />
    <SolidColorBrush x:Key="Brush.MutedForeground" Color="{StaticResource Color.MutedForeground}" />
    <SolidColorBrush x:Key="Brush.SubtleForeground" Color="{StaticResource Color.SubtleForeground}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}" />
    <SolidColorBrush x:Key="Brush.Ring" Color="{StaticResource Color.Ring}" />

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="{StaticResource Color.PrimaryForeground}" />
    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}" />
    <SolidColorBrush x:Key="Brush.SecondaryHover" Color="{StaticResource Color.SecondaryHover}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Sun" Color="{StaticResource Color.Sun}" />
    <SolidColorBrush x:Key="Brush.SunSoft" Color="{StaticResource Color.SunSoft}" />
    <SolidColorBrush x:Key="Brush.SunInk" Color="{StaticResource Color.SunInk}" />
    <SolidColorBrush x:Key="Brush.Destructive" Color="{StaticResource Color.Destructive}" />
    <SolidColorBrush x:Key="Brush.DestructiveSoft" Color="{StaticResource Color.DestructiveSoft}" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.SidebarForeground" Color="{StaticResource Color.SidebarForeground}" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="{StaticResource Color.SidebarMuted}" />
    <SolidColorBrush x:Key="Brush.SidebarStep" Color="{StaticResource Color.SidebarStep}" />
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="{StaticResource Color.SidebarBorder}" />
</ResourceDictionary>
