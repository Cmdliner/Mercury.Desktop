<UserControl x:Class="Mercury.Desktop.Views.Workspace.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
             Style="{StaticResource View.StepEntrance}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,40">
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource Font.SemiBold}" FontSize="28" Text="Receive a payment" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}"
                               Text="Give the customer this account. The payment is matched to the store automatically." />
                </StackPanel>
                <controls:FormField Width="240" HorizontalAlignment="Right" VerticalAlignment="Center" Header="Store">
                    <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:FormField>
            </Grid>

            <!-- Two columns: a textured panel, then the payment details. -->
            <Border CornerRadius="{StaticResource Radius.2xl}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Background="{StaticResource Brush.Card}">
                <Grid MinHeight="400">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <!-- Texture panel -->
                    <Border CornerRadius="15,0,0,15" DataContext="{Binding SelectedStore}">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/Images/glass.jpg" Stretch="UniformToFill" />
                        </Border.Background>
                        <Grid ClipToBounds="True">
                        <Border CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#990A0A0A" Offset="0" />
                                    <GradientStop Color="#E60A0A0A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <controls:BeadIllustration Width="260" Height="195"
                                                   Margin="0,0,-30,-20"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource Brush.SidebarForeground}"
                                                   Opacity="0.55" />
                        <StackPanel Margin="40,40,40,0" VerticalAlignment="Top">
                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                       Foreground="{StaticResource Brush.SidebarMuted}" Text="PAYMENT DETAILS" />
                            <TextBlock Margin="0,16,0,0" FontFamily="{StaticResource Font.SemiBold}" FontSize="30"
                                       Foreground="{StaticResource Brush.SidebarForeground}" TextWrapping="Wrap">
                                <Run Text="Pay " /><Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,12,0,0" FontSize="14" LineHeight="21"
                                       Foreground="{StaticResource Brush.SidebarMuted}" TextWrapping="Wrap"
                                       Text="Send the amount from any bank app. Mercury records it against this store as soon as the bank confirms it." />
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Payment details -->
                    <StackPanel Grid.Column="1" Margin="48,44,48,44" VerticalAlignment="Center"
                                DataContext="{Binding SelectedStore}">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Bank" />
                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Medium}" FontSize="18" Text="{Binding Bank}" />

                        <TextBlock Margin="0,28,0,0" Style="{StaticResource Text.Caption}" Text="Account number" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock FontFamily="{StaticResource Font.MonoMedium}" FontSize="38" Text="{Binding AccountNumber}" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding DataContext.CopyAccountNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource Button.Outline}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Width="14" Height="14" Data="{StaticResource Icon.Copy}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   StrokeThickness="1.8" />
                                    <TextBlock Margin="8,0,0,1" Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Success}" Text="Account number copied."
                                   Visibility="{Binding DataContext.JustCopied, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.BoolToVisibility}}" />

                        <TextBlock Margin="0,28,0,0" Style="{StaticResource Text.Caption}" Text="Account name" />
                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Medium}" FontSize="18"
                                   Text="{Binding DataContext.AccountName, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <Border Margin="0,32,0,20" Style="{StaticResource Surface.Divider}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Pill.Success}">
                                <TextBlock Text="Active" />
                            </Border>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                                       Text="Accepting transfers, any amount" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- How it works -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Eyebrow}" Text="01" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Customer transfers" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="They send any amount from their bank app." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Eyebrow}" Text="02" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Mercury matches it" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="It is recorded against this store once the bank confirms." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Eyebrow}" Text="03" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="It reaches your books" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="See it under Transactions and in today's reconciliation." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
