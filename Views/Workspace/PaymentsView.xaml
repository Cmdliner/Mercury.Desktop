<UserControl x:Class="Mercury.Desktop.Views.Workspace.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
             xmlns:models="clr-namespace:Mercury.Desktop.Models"
             Style="{StaticResource View.StepEntrance}">

    <UserControl.Resources>
        <!-- Another account of the same store, shown small under the main one. -->
        <DataTemplate DataType="{x:Type models:CollectionAccountInfo}">
            <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}">
                <Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusLabel, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Directory.IsLoaded, Converter={StaticResource Converter.BoolToVisibility}}">
            <StackPanel Margin="40,36,40,40">
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.SemiBold}" FontSize="28" Text="Receive a payment" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}"
                                   Text="Give the customer this account. The payment is matched to the store automatically." />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"
                                Visibility="{Binding HasStore, Converter={StaticResource Converter.BoolToVisibility}}">
                        <controls:FormField Width="240" Header="Store">
                            <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:FormField>
                        <Button Margin="12,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding OpenAddCommand}"
                                Content="Add account"
                                Visibility="{Binding CanAddAccount, Converter={StaticResource Converter.BoolToVisibility}}"
                                Style="{StaticResource Button.Outline}" />
                    </StackPanel>
                </Grid>

                <!-- No stores to collect for -->
                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding Directory.HasNoStores, Converter={StaticResource Converter.BoolToVisibility}}">
                    <controls:BeadIllustration Width="200" Height="150" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Heading}" Text="No stores yet" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Muted}"
                               Text="Add a store first, then come back here for its payment account." />
                </StackPanel>

                <!-- Two columns: a textured panel, then the payment details. -->
                <StackPanel Visibility="{Binding HasStore, Converter={StaticResource Converter.BoolToVisibility}}">
                    <Border CornerRadius="{StaticResource Radius.2Xl}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Background="{StaticResource Brush.Card}">
                        <Grid MinHeight="400">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <!-- Texture panel -->
                            <Border CornerRadius="15,0,0,15" DataContext="{Binding SelectedStore}">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Resources/Images/glass.jpg" Stretch="UniformToFill" />
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <Border CornerRadius="15,0,0,15">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#990A0A0A" Offset="0" />
                                                <GradientStop Color="#E60A0A0A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <controls:BeadIllustration Width="260" Height="195"
                                                               Margin="0,0,-30,-20"
                                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                               Foreground="{StaticResource Brush.SidebarForeground}"
                                                               Opacity="0.55" />
                                    <StackPanel Margin="40,40,40,0" VerticalAlignment="Top">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                   Foreground="{StaticResource Brush.SidebarMuted}" Text="PAYMENT DETAILS" />
                                        <TextBlock Margin="0,16,0,0" FontFamily="{StaticResource Font.SemiBold}" FontSize="30"
                                                   Foreground="{StaticResource Brush.SidebarForeground}" TextWrapping="Wrap">
                                            <Run Text="Pay " /><Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,12,0,0" FontSize="14" LineHeight="21"
                                                   Foreground="{StaticResource Brush.SidebarMuted}" TextWrapping="Wrap"
                                                   Text="Send the amount from any bank app. Mercury records it against this store as soon as the bank confirms it." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Payment details: the account, or what to do when there is none yet -->
                            <Grid Grid.Column="1" Margin="48,44,48,44" VerticalAlignment="Center">
                                <StackPanel DataContext="{Binding SelectedStore}"
                                            Visibility="{Binding IsActive, Converter={StaticResource Converter.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Bank" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Medium}" FontSize="18"
                                               Text="{Binding Primary.BankName}" />

                                    <TextBlock Margin="0,28,0,0" Style="{StaticResource Text.Caption}" Text="Account number" />
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock FontFamily="{StaticResource Font.MonoMedium}" FontSize="38"
                                                   Text="{Binding Primary.AccountNumber}" />
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Command="{Binding DataContext.CopyAccountNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource Button.Outline}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Width="14" Height="14" Data="{StaticResource Icon.Copy}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               StrokeThickness="1.8" />
                                                <TextBlock Margin="8,0,0,1" Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Success}" Text="Account number copied."
                                               Visibility="{Binding DataContext.JustCopied, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.BoolToVisibility}}" />

                                    <TextBlock Margin="0,28,0,0" Style="{StaticResource Text.Caption}" Text="Account name" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Medium}" FontSize="18"
                                               Text="{Binding Primary.AccountName}" />

                                    <Border Margin="0,32,0,20" Style="{StaticResource Surface.Divider}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Pill.Success}">
                                            <TextBlock Text="Active" />
                                        </Border>
                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                                                   Text="{Binding Primary.KindLabel}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,20,0,0"
                                                Visibility="{Binding HasOtherAccounts, Converter={StaticResource Converter.BoolToVisibility}}">
                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Eyebrow}" Text="OTHER ACCOUNTS" />
                                        <ItemsControl ItemsSource="{Binding OtherAccounts}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- The account is being set up with the bank -->
                                <StackPanel DataContext="{Binding SelectedStore}"
                                            Visibility="{Binding IsPending, Converter={StaticResource Converter.BoolToVisibility}}">
                                    <Border HorizontalAlignment="Left" Style="{StaticResource Pill.Caution}">
                                        <TextBlock Text="Setting up" />
                                    </Border>
                                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Subtitle}" Text="Creating your account" />
                                    <TextBlock Margin="0,8,0,20" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                               Text="The bank is confirming your details. This usually takes a few minutes." />
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="Check again" Style="{StaticResource Button.Outline}" />
                                </StackPanel>

                                <!-- The bank could not set it up -->
                                <StackPanel DataContext="{Binding SelectedStore}"
                                            Visibility="{Binding IsFailed, Converter={StaticResource Converter.BoolToVisibility}}">
                                    <Border HorizontalAlignment="Left" Style="{StaticResource Pill.Caution}">
                                        <TextBlock Text="Needs attention" />
                                    </Border>
                                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Subtitle}" Text="We could not create the account" />
                                    <TextBlock Margin="0,8,0,20" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                               Text="{Binding Primary.FailureReason}" />
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="Try again"
                                            Visibility="{Binding DataContext.CanAddAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.BoolToVisibility}}"
                                            Style="{StaticResource Button.Outline}" />
                                </StackPanel>

                                <!-- Nothing yet -->
                                <StackPanel DataContext="{Binding SelectedStore}"
                                            Visibility="{Binding HasNoAccount, Converter={StaticResource Converter.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="No payment account yet" />
                                    <TextBlock Margin="0,8,0,20" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                               Text="Customers need an account number to pay into. Add one for this store." />
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="Add an account"
                                            Visibility="{Binding DataContext.CanAddAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Ask the owner to add one."
                                               Visibility="{Binding DataContext.CanAddAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.InverseBoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- How it works -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="01" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Customer transfers" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="They send any amount from their bank app." />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="02" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Mercury matches it" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="It is recorded against this store once the bank confirms." />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="03" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="It reaches your books" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="See it under Transactions and in the day's ledger." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- While the stores load -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Muted}"
                   Text="Loading your payment details..."
                   Visibility="{Binding Directory.IsLoading, Converter={StaticResource Converter.BoolToVisibility}}" />

        <!-- If they could not be loaded -->
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Directory.HasError, Converter={StaticResource Converter.BoolToVisibility}}">
            <controls:BeadIllustration Width="200" Height="150" HorizontalAlignment="Center" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Heading}" Text="We could not load your payment details" />
            <TextBlock Margin="0,8,0,20" HorizontalAlignment="Center" Style="{StaticResource Text.Muted}"
                       Text="{Binding Directory.ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Command="{Binding RefreshCommand}" Content="Try again"
                    Style="{StaticResource Button.Outline}" />
        </StackPanel>

        <!-- Add a payment account -->
        <Grid Background="#B30A0A0A"
              Visibility="{Binding IsAdding, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="500" MaxHeight="640" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Add a payment account" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                           Text="Where this store receives money." />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseAddCommand}"
                                    Style="{StaticResource Button.Icon}" ToolTip="Close">
                                <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.Close}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.8" />
                            </Button>
                        </Grid>

                        <CheckBox Margin="0,24,0,0" IsChecked="{Binding UseMercuryAccount}"
                                  Content="Create a Mercury account for this store" />

                        <!-- A Mercury account: needs identity to open -->
                        <StackPanel DataContext="{Binding MercuryForm}"
                                    Visibility="{Binding DataContext.UseMercuryAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.BoolToVisibility}}">
                            <TextBlock Margin="0,12,0,20" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Text="The bank needs your BVN and the account it belongs to to open this. We pass them on to verify you and never keep the BVN." />
                            <controls:FormField Margin="0,0,0,18" Header="BVN">
                                <TextBox controls:InputHelper.Placeholder="11 digits"
                                         Text="{Binding Bvn, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FormField>
                            <controls:FormField Margin="0,0,0,18" Header="Bank your BVN is linked to">
                                <ComboBox controls:InputHelper.Placeholder="Choose a bank"
                                          ItemsSource="{Binding Banks}" SelectedItem="{Binding Bank}" />
                            </controls:FormField>
                            <controls:FormField Margin="0,0,0,8" Header="Account number">
                                <TextBox controls:InputHelper.Placeholder="10 digits"
                                         Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FormField>
                        </StackPanel>

                        <!-- An account the business already uses -->
                        <StackPanel DataContext="{Binding LinkForm}"
                                    Visibility="{Binding DataContext.UseMercuryAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.InverseBoolToVisibility}}">
                            <TextBlock Margin="0,12,0,20" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Text="Record an account you already collect into, such as OPay or Moniepoint. Mercury will track what goes through it." />
                            <controls:FormField Margin="0,0,0,18" Header="Bank or wallet">
                                <ComboBox controls:InputHelper.Placeholder="Choose a bank"
                                          ItemsSource="{Binding Banks}" SelectedItem="{Binding Bank}" />
                            </controls:FormField>
                            <controls:FormField Margin="0,0,0,18" Header="Account number">
                                <TextBox controls:InputHelper.Placeholder="10 digits"
                                         Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FormField>
                            <controls:FormField Margin="0,0,0,8" Header="Name on the account">
                                <TextBox controls:InputHelper.Placeholder="Adeyemi Stores"
                                         Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FormField>
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Error}" Text="{Binding FormError}" TextWrapping="Wrap"
                                   Visibility="{Binding HasFormError, Converter={StaticResource Converter.BoolToVisibility}}" />

                        <Button Margin="0,24,0,0" HorizontalAlignment="Right"
                                Command="{Binding AddAccountCommand}"
                                Content="{Binding AddLabel}"
                                Style="{StaticResource Button.Primary.Lg}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
