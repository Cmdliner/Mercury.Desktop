<UserControl x:Class="Mercury.Desktop.Views.Workspace.StoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
             xmlns:models="clr-namespace:Mercury.Desktop.Models"
             Style="{StaticResource View.StepEntrance}">

    <UserControl.Resources>
        <!-- One store: where it is, the account it takes payments into, and what it holds. -->
        <DataTemplate DataType="{x:Type models:StoreAccount}">
            <Border Width="340"
                    Margin="0,0,16,16"
                    Padding="24"
                    CornerRadius="{StaticResource Radius.Xl}"
                    Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock MaxWidth="210" HorizontalAlignment="Left"
                                       Style="{StaticResource Text.Heading}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Location}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Pill.Success}">
                            <TextBlock Text="Active" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Text.Caption}" Text="Balance" />
                    <TextBlock Margin="0,4,0,20"
                               Style="{StaticResource Text.Stat}"
                               Text="{Binding Balance, Converter={StaticResource Converter.Naira}}" />
                    <Border Style="{StaticResource Surface.Divider}" />
                    <Grid Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Bank}" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="13"
                                   Text="{Binding AccountNumber}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,36,24,40">
                <Grid Margin="0,0,16,28">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.SemiBold}" FontSize="28" Text="Your stores" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Muted}"
                                   Text="Each store has its own virtual account, so payments are never mixed up." />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding OpenAddStoreCommand}"
                            Style="{StaticResource Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Width="14" Height="14"
                                           Data="{StaticResource Icon.Plus}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="2" />
                            <TextBlock Margin="8,0,0,1" Text="Add store" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Stores}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Add store dialog -->
        <Grid Background="#990F0F0F"
              Visibility="{Binding IsAdding, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="480"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Xl}"
                    Style="{StaticResource Surface.Card}">
                <StackPanel DataContext="{Binding Form}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Add store" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" Text="Create another Mercury location." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseAddStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Close">
                            <controls:Icon Width="16" Height="16"
                                           Data="{StaticResource Icon.Close}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.8" />
                        </Button>
                    </Grid>

                    <controls:FormField Margin="0,28,0,18" Header="Store name">
                        <TextBox controls:InputHelper.Placeholder="Mercury Lekki"
                                 Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FormField>
                    <controls:FormField Margin="0,0,0,18" Header="Location">
                        <TextBox controls:InputHelper.Placeholder="Lekki, Lagos"
                                 Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FormField>
                    <controls:FormField Margin="0,0,0,28" Header="Virtual account">
                        <TextBox controls:InputHelper.Placeholder="10-digit account number"
                                 Text="{Binding VirtualAccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FormField>

                    <Button HorizontalAlignment="Right"
                            Command="{Binding DataContext.CreateStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="Create store"
                            Style="{StaticResource Button.Primary.Lg}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
