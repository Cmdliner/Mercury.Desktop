<UserControl x:Class="Mercury.Desktop.Views.Workspace.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
             xmlns:models="clr-namespace:Mercury.Desktop.Models"
             Style="{StaticResource View.StepEntrance}">

    <UserControl.Resources>
        <!-- One account: what it is for, what it holds and its share of the total. -->
        <DataTemplate DataType="{x:Type models:LedgerAccount}">
            <Button Margin="0,0,16,16"
                    Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource Button.Plain}">
            <Border Padding="24"
                    CornerRadius="{StaticResource Radius.Xl}"
                    Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <Grid>
                        <Border Width="40" Height="40" HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Secondary}" CornerRadius="20">
                            <controls:Icon Width="18" Height="18"
                                           Data="{Binding IconKey, Converter={StaticResource Converter.Icon}}"
                                           StrokeThickness="1.8" />
                        </Border>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Text.Caption}">
                            <Run Text="{Binding Share, Mode=OneWay, StringFormat={}{0:P0}}" /><Run Text=" of total" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource Text.Heading}" Text="{Binding Name}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Description}" />
                    <controls:Money Margin="0,18,0,18" Amount="{Binding Balance}" Style="{StaticResource Text.Stat}" />
                    <Grid Height="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Filled}" />
                            <ColumnDefinition Width="{Binding Rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource Brush.Input}" CornerRadius="3" />
                        <Border Background="{StaticResource Brush.Foreground}" CornerRadius="3" />
                    </Grid>
                </StackPanel>
            </Border>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LedgerEntry}">
            <Button Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource Button.TableRow}">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Date}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Description}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Body}" Text="{Binding From}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Body}" Text="{Binding To}" />
                    <controls:Money Grid.Column="4" HorizontalAlignment="Right" Amount="{Binding Amount}"
                                    FontFamily="{StaticResource Font.Medium}" FontSize="14" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsLoaded, Converter={StaticResource Converter.BoolToVisibility}}">
        <StackPanel Margin="40,36,24,40">
            <Grid Margin="0,0,16,28">
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource Font.SemiBold}" FontSize="28" Text="Accounts" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}"
                               Text="Where the money sits, from the ledger. Every payment is split between these accounts." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" Text="Total across accounts" />
                    <controls:Money Margin="0,2,0,0" HorizontalAlignment="Right" Amount="{Binding Total}"
                                    FontFamily="{StaticResource Font.SemiBold}" FontSize="22" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Margin="0,0,16,0" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Margin="24,24,24,16" Style="{StaticResource Text.Heading}" Text="Recent ledger entries" />
                    <Grid Margin="24,0,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Eyebrow}" Text="DATE" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Eyebrow}" Text="DESCRIPTION" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Eyebrow}" Text="FROM" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Eyebrow}" Text="TO" />
                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource Text.Eyebrow}" Text="AMOUNT" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Entries}" />
                    <TextBlock Margin="24,8,24,24" Style="{StaticResource Text.Muted}"
                               Text="Money moving between your accounts will be listed here."
                               Visibility="{Binding HasEntries, Converter={StaticResource Converter.InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

        <!-- While the accounts load -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Muted}"
                   Text="Loading your accounts..."
                   Visibility="{Binding IsLoading, Converter={StaticResource Converter.BoolToVisibility}}" />

        <!-- If they could not be loaded -->
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource Converter.BoolToVisibility}}">
            <controls:BeadIllustration Width="200" Height="150" HorizontalAlignment="Center" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Heading}" Text="We could not load your accounts" />
            <TextBlock Margin="0,8,0,20" HorizontalAlignment="Center" Style="{StaticResource Text.Muted}"
                       Text="{Binding ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Command="{Binding LoadCommand}" Content="Try again"
                    Style="{StaticResource Button.Outline}" />
        </StackPanel>

        <!-- A business with no stores has no accounts yet -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoAccounts, Converter={StaticResource Converter.BoolToVisibility}}">
            <controls:BeadIllustration Width="200" Height="150" HorizontalAlignment="Center" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Heading}" Text="No accounts yet" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Muted}"
                       Text="Accounts appear once you have added a store." />
        </StackPanel>

        <!-- Detail dialog -->
        <Grid Background="#B30A0A0A"
              Visibility="{Binding IsAccountOpen, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="440" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                <StackPanel DataContext="{Binding SelectedAccount}">
                    <Grid>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Account details" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Button.Icon}" ToolTip="Close">
                            <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.Close}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.8" />
                        </Button>
                    </Grid>
                    <Border Margin="0,24,0,0" Width="48" Height="48" HorizontalAlignment="Left"
                            Background="{StaticResource Brush.Secondary}" CornerRadius="24">
                        <controls:Icon Width="20" Height="20"
                                       Data="{Binding IconKey, Converter={StaticResource Converter.Icon}}"
                                       StrokeThickness="1.8" />
                    </Border>
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Heading}" Text="{Binding Name}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Description}" />
                    <controls:Money Margin="0,20,0,22" Amount="{Binding Balance}" Style="{StaticResource Text.Stat}" />
                    <Grid Height="6" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Filled}" />
                            <ColumnDefinition Width="{Binding Rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource Brush.Input}" CornerRadius="3" />
                        <Border Background="{StaticResource Brush.Foreground}" CornerRadius="3" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}">
                        <Run Text="{Binding Share, Mode=OneWay, StringFormat={}{0:P0}}" /><Run Text=" of everything across your accounts" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detail dialog -->
        <Grid Background="#B30A0A0A"
              Visibility="{Binding IsEntryOpen, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="440" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                <StackPanel DataContext="{Binding SelectedEntry}">
                    <Grid>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Ledger entry" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Button.Icon}" ToolTip="Close">
                            <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.Close}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.8" />
                        </Button>
                    </Grid>
                    <controls:Money Margin="0,24,0,2" Amount="{Binding Amount}" Style="{StaticResource Text.Stat}" />
                    <TextBlock Margin="0,0,0,22" Style="{StaticResource Text.Caption}" Text="{Binding Description}" />
                    <Border Margin="0,0,0,22" Style="{StaticResource Surface.Divider}" />
                    <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Date" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" Text="{Binding Date}" />
                        </Grid>
                    <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Moved from" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" Text="{Binding From}" />
                        </Grid>
                    <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Moved to" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" Text="{Binding To}" />
                        </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>