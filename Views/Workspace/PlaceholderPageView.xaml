<UserControl x:Class="Mercury.Desktop.Views.Workspace.PlaceholderPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource View.StepEntrance}">

    <!-- Shown for pages that are designed but not built yet. -->
    <StackPanel MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <Border Margin="0,0,0,18" Style="{StaticResource Pill.Caution}">
            <TextBlock Text="Coming next" />
        </Border>
        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
        <TextBlock Margin="0,10,0,0"
                   Style="{StaticResource Text.Lead}"
                   Text="{Binding Description}" />
    </StackPanel>
</UserControl>
