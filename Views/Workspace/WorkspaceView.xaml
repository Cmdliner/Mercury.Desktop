<UserControl x:Class="Mercury.Desktop.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
             xmlns:local="clr-namespace:Mercury.Desktop.Views.Workspace"
             xmlns:vm="clr-namespace:Mercury.Desktop.ViewModels.Workspace">

    <UserControl.Resources>
        <!-- Which view shows each page. -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <local:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StoresViewModel}">
            <local:StoresView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
            <local:PaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <local:TransactionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <local:AccountsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <local:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <local:PlaceholderPageView />
        </DataTemplate>

        <!-- A button that wraps any content with no chrome of its own, such as an avatar. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in the user menu. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Padding="12,10" Background="Transparent" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Scrim" TargetType="Grid">
            <Setter Property="Background" Value="#B30A0A0A" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: near-black, for contrast with the warm pages. -->
        <Border Width="260"
                Background="{StaticResource Brush.Sidebar}"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="76" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="14,0,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The business -->
                <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="40" Height="40"
                            Background="{StaticResource Brush.SidebarStep}"
                            CornerRadius="10">
                        <controls:Icon Width="20" Height="20"
                                       Data="{StaticResource Icon.Store}"
                                       Foreground="{StaticResource Brush.SidebarForeground}"
                                       StrokeThickness="1.8" />
                    </Border>
                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Converter.InverseBoolToVisibility}}">
                        <TextBlock MaxWidth="160"
                                   FontFamily="{StaticResource Font.SemiBold}"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.SidebarForeground}"
                                   Text="{Binding BusinessName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.SidebarMuted}"
                                   Text="Workspace" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         Margin="0,12,0,0"
                         ItemsSource="{Binding NavView}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Style="{StaticResource ListBox.Navigation}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="14,22,0,10"
                                               Foreground="{StaticResource Brush.SidebarMuted}"
                                               Opacity="0.7"
                                               Style="{StaticResource Text.Eyebrow}"
                                               Text="{Binding Name}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Converter.InverseBoolToVisibility}}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <!-- Signed-in owner: opens the same menu as the avatar in the top bar. -->
                <Button Grid.Row="2"
                        Command="{Binding OpenUserMenuCommand}"
                        Style="{StaticResource PlainButton}">
                    <Border Padding="8"
                            Background="{StaticResource Brush.SidebarStep}"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="36" Height="36"
                                    Background="{StaticResource Brush.SidebarForeground}"
                                    CornerRadius="18">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Medium}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Sidebar}"
                                           Text="{Binding OwnerInitials}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Converter.InverseBoolToVisibility}}">
                                <TextBlock MaxWidth="150"
                                           FontFamily="{StaticResource Font.Medium}"
                                           FontSize="13"
                                           Foreground="{StaticResource Brush.SidebarForeground}"
                                           Text="{Binding OwnerName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource Brush.SidebarMuted}"
                                           Text="Owner" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- Main area: top bar, then the page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0,32,0">
                    <Button HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Collapse or expand the sidebar">
                        <controls:Icon Width="18" Height="18"
                                       Data="{StaticResource Icon.Sidebar}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.8" />
                    </Button>
                    <StackPanel Margin="52,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding CurrentPage.Title}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}">
                            <Run Text="Mercury" />
                            <Run Text="/" />
                            <Run Text="{Binding CurrentPage.Title, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ComboBox Width="168"
                                  Height="36"
                                  controls:InputHelper.Placeholder="All stores"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All stores" />
                            <ComboBoxItem Content="Ikeja" />
                            <ComboBoxItem Content="Yaba" />
                            <ComboBoxItem Content="Lekki" />
                        </ComboBox>
                        <Button Margin="12,0,0,0"
                                Command="{Binding ToggleAmountsCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Show or hide amounts">
                            <controls:Icon Width="18" Height="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.8">
                                <controls:Icon.Style>
                                    <Style TargetType="controls:Icon" BasedOn="{StaticResource {x:Type controls:Icon}}">
                                        <Setter Property="Data" Value="{StaticResource Icon.Eye}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsAmountsHidden, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.EyeOff}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:Icon.Style>
                            </controls:Icon>
                        </Button>
                        <Button Margin="4,0,0,0"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Search">
                            <controls:Icon Width="18" Height="18"
                                           Data="{StaticResource Icon.Search}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.8" />
                        </Button>

                        <!-- The avatar opens the user menu. -->
                        <Button x:Name="AvatarButton"
                                Margin="8,0,0,0"
                                Command="{Binding OpenUserMenuCommand}"
                                Style="{StaticResource PlainButton}"
                                ToolTip="Account">
                            <Border Style="{StaticResource Surface.Avatar}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding OwnerInitials}" />
                            </Border>
                        </Button>

                        <Popup AllowsTransparency="True"
                               HorizontalOffset="-224"
                               IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=AvatarButton}"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               VerticalOffset="10">
                            <Border Width="260"
                                    Margin="0,0,12,12"
                                    Padding="8"
                                    Background="{StaticResource Brush.Card}"
                                    BorderBrush="{StaticResource Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <StackPanel Margin="8,8,8,14" Orientation="Horizontal">
                                        <Border Width="44" Height="44" Style="{StaticResource Surface.Avatar}" CornerRadius="22">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding OwnerInitials}" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock MaxWidth="170" Style="{StaticResource Text.Label}" Text="{Binding OwnerName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock MaxWidth="170" Style="{StaticResource Text.Caption}" Text="{Binding OwnerEmail}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Margin="0,0,0,6" Style="{StaticResource Surface.Divider}" />

                                    <Button Command="{Binding ShowProfileCommand}" Style="{StaticResource MenuRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.Users}" StrokeThickness="1.8" />
                                            <TextBlock Margin="12,0,0,1" Style="{StaticResource Text.Label}" Text="Profile details" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding HideAmountsFromMenuCommand}" Style="{StaticResource MenuRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.Eye}" StrokeThickness="1.8" />
                                            <TextBlock Margin="12,0,0,1" Style="{StaticResource Text.Label}" Text="Show or hide amounts" />
                                        </StackPanel>
                                    </Button>

                                    <Border Margin="0,6,0,6" Style="{StaticResource Surface.Divider}" />
                                    <Button Command="{Binding RequestSignOutCommand}" Style="{StaticResource MenuRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.ArrowLeft}"
                                                           Foreground="{StaticResource Brush.Destructive}" StrokeThickness="1.8" />
                                            <TextBlock Margin="12,0,0,1" Foreground="{StaticResource Brush.Destructive}"
                                                       Style="{StaticResource Text.Label}" Text="Sign out" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Profile details dialog -->
        <Grid Grid.ColumnSpan="2"
              Style="{StaticResource Scrim}"
              Visibility="{Binding IsProfileOpen, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="440" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Profile details" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseProfileCommand}"
                                Style="{StaticResource Button.Icon}" ToolTip="Close">
                            <controls:Icon Width="16" Height="16" Data="{StaticResource Icon.Close}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.8" />
                        </Button>
                    </Grid>
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <Border Width="56" Height="56" Style="{StaticResource Surface.Avatar}" CornerRadius="28">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Text="{Binding OwnerInitials}" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding OwnerName}" />
                            <Border Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource Pill.Success}">
                                <TextBlock Text="Owner" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border Margin="0,24,0,0" Style="{StaticResource Surface.Divider}" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource Text.Caption}" Text="Email" />
                        <TextBlock Grid.Column="1" Margin="0,0,0,16" Style="{StaticResource Text.Label}" Text="{Binding OwnerEmail}" />
                        <TextBlock Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource Text.Caption}" Text="Business" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,16" Style="{StaticResource Text.Label}" Text="{Binding BusinessName}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Text="Role" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Label}" Text="Owner, full access" />
                    </Grid>
                    <Button Margin="0,28,0,0" HorizontalAlignment="Right"
                            Command="{Binding CloseProfileCommand}" Content="Done"
                            Style="{StaticResource Button.Outline}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sign out confirmation -->
        <Grid Grid.ColumnSpan="2"
              Style="{StaticResource Scrim}"
              Visibility="{Binding IsSignOutConfirming, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="420" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <Border Width="44" Height="44" HorizontalAlignment="Left"
                            Background="{StaticResource Brush.Secondary}" CornerRadius="22">
                        <controls:Icon Width="18" Height="18" Data="{StaticResource Icon.ArrowLeft}" StrokeThickness="1.8" />
                    </Border>
                    <TextBlock Margin="0,20,0,0" Style="{StaticResource Text.Subtitle}" Text="Sign out of Mercury?" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Text="You will need to sign in again to see your stores and accounts." />
                    <StackPanel Margin="0,28,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding CancelSignOutCommand}" Content="Cancel" Style="{StaticResource Button.Outline}" />
                        <Button Margin="12,0,0,0" Command="{Binding ConfirmSignOutCommand}" Content="Sign out" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
