<UserControl x:Class="Mercury.Desktop.Views.OwnerAccountSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mercury.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid>
<!-- Full name -->
        <StackPanel Width="460" VerticalAlignment="Center">
            <TextBlock
                Text="Create your Owner Account"
                FontWeight="SemiBold"
                FontSize="30"
                FontFamily="Geist" />
            
            <TextBlock 
                Text="This account will manage the Mercury workspace"
                Margin="0 0  0 32"
                Foreground="{StaticResource MercuryTextBrush}"
                FontFamily="Geist"
                FontWeight="Normal"
                FontSize="13"
                />
            <!-- Email Address -->
            <StackPanel>
                <Label 
                    Content="Full name" 
                    FontSize="11" 
                    FontFamily="Geist"
                    Foreground="{StaticResource MercuryTextBrush}"
                    />
                <TextBox Text="{Binding FullName}"/>
            </StackPanel>
            
            <!-- Password -->
            <StackPanel>
                <Label 
                    Content="Password" 
                    FontSize="11" 
                    FontFamily="Geist"
                    Foreground="{StaticResource MercuryTextBrush}"
                />
                <PasswordBox Password="{Binding Password}"/>
            </StackPanel>
            
            <!-- Password -->
            <StackPanel>
                <Label 
                    Content="Confirm Password" 
                    FontSize="11" 
                    FontFamily="Geist"
                    Foreground="{StaticResource MercuryTextBrush}"
                />
                <PasswordBox Password="{Binding ConfirmPassword}"/>
            </StackPanel>
            
            <StackPanel>
                <Label 
                    Content="Email" 
                    FontSize="11" 
                    FontFamily="Geist"
                    Foreground="{StaticResource MercuryTextBrush}"
                />
                <TextBox Text="{Binding EmailAddress}"/>
            </StackPanel>
            
            <StackPanel>
                <Label 
                    Content="Email" 
                    FontSize="11" 
                    FontFamily="Geist"
                    Foreground="{StaticResource MercuryTextBrush}"
                />
                <TextBox Text="{Binding EmailAddress}"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>