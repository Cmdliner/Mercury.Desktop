<UserControl x:Class="Mercury.Desktop.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mercury.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="800">
    <Grid Background="{StaticResource MercuryWhiteBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border
            Grid.Column="0"
            BorderBrush="{StaticResource MercuryBorderBrush}"
            BorderThickness="0 0 1 0"
            Background="{StaticResource MercuryBlackBrush}"
            Padding="32">

            <StackPanel >
                <TextBlock
                    Text="Mercury"
                    FontFamily="Geist"
                    FontWeight="SemiBold"
                    FontSize="20"
                    Foreground="{StaticResource MercuryWhiteBrush}" />
                <TextBlock
                    Margin="0 48 0 0"
                    Text="Set up your Business"
                    FontFamily="Geist"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource MercuryWhiteBrush}" />

                <!-- Step 1 -->

                <StackPanel
                    Margin="0,32,0,0"
                    Orientation="Horizontal">

                    <TextBlock
                        Text="01"
                        FontFamily="Geist"
                        FontSize="12"
                        Foreground="{StaticResource MercuryWhiteBrush}" />

                    <TextBlock
                        Margin="0,5,0,0"
                        Text="Business details"
                        FontFamily="Geist"
                        FontSize="14"
                        Foreground="{StaticResource MercuryWhiteBrush}" />

                </StackPanel>


                <!-- Step 2 -->

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,28,0,0">

                    <TextBlock
                        Text="02"
                        FontFamily="Geist"
                        FontSize="12"
                        Foreground="{StaticResource MercuryMutedBrush}" />

                    <TextBlock
                        Margin="0,5,0,0"
                        Text="Owner account"
                        FontFamily="Geist"
                        FontSize="14"
                        Foreground="{StaticResource MercuryMutedBrush}" />

                </StackPanel>


                <!-- Step 3 -->

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,28,0,0">

                    <TextBlock
                        Text="03"
                        FontFamily="Geist"
                        FontSize="12"
                        Foreground="{StaticResource MercuryMutedBrush}" />

                    <TextBlock
                        Margin="0,5,0,0"
                        Text="First store"
                        FontFamily="Geist"
                        FontSize="14"
                        Foreground="{StaticResource MercuryMutedBrush}" />

                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- CURRENT ONBOARDING SCREEN -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</UserControl>