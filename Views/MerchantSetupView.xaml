<UserControl x:Class="Mercury.Desktop.Views.MerchantSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mercury.Desktop.Views"
             mc:Ignorable="d">

    <Grid Background="{StaticResource MercurySurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Width="460">
            <TextBlock
                Text="Tell us about your business"
                FontFamily="Geist"
                FontSize="30"
                FontWeight="SemiBold"
                Foreground="{StaticResource MercuryTextBrush}" />
            
            
            <TextBlock
                Margin="0,8,0,24"
                Text="This information appears across your mercury workspace"
                FontFamily="Geist"
                FontSize="13"
                Foreground="{StaticResource MercuryMutedBrush}" />
            

            <!-- Business Name -->
            <TextBlock
                Text="Business name"
                FontFamily="Geist"
                FontSize="13"
                Foreground="{StaticResource MercuryTextBrush}" />
            <TextBox
                Margin="0 8 0 24"
                Height="44"
                Padding="12 0"
                VerticalContentAlignment="Center"
                Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Business Email -->
            <TextBlock
                Text="Business email"
                FontFamily="Geist"
                FontSize="13"
                Foreground="{StaticResource MercuryTextBrush}" />
            <TextBox
                Margin="0 8 0 24"
                Height="44"
                Padding="12 0"
                VerticalContentAlignment="Center"
                Text="{Binding BusinessEmail, UpdateSourceTrigger=PropertyChanged}" />
            <!-- Business Phone -->
            <TextBlock
                Text="Business phone"
                FontFamily="Geist"
                FontSize="13"
                Foreground="{StaticResource MercuryTextBrush}" />
            <TextBox
                Margin="0 8 0 24"
                Height="44"
                Padding="12 0"
                VerticalContentAlignment="Center"
                Text="{Binding BusinessPhone, UpdateSourceTrigger=PropertyChanged}" />
            <!-- Business Address -->
            <TextBlock
                Text="Business address"
                FontFamily="Geist"
                FontSize="13"
                Foreground="{StaticResource MercuryTextBrush}" />
            <TextBox
                Margin="0 8 0 24"
                Height="44"
                Padding="12 0"
                VerticalContentAlignment="Center"
                Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Business Type -->

            <ComboBox
                Margin=" 0 8 0 0"
                Height="44"
                Padding="12 0"
                SelectedValue="{Binding BusinessType}"
                SelectedValuePath="Content">

                <ComboBoxItem Content="Pharmacy" />
                <ComboBoxItem Content="Hospital" />
                <ComboBoxItem Content="Clinic" />
            </ComboBox>

            <TextBlock
                Text="Business type"
                FontFamily="Geist"
                FontSize="13"
                Foreground="{StaticResource MercuryTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>