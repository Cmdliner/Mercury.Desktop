<UserControl x:Class="Mercury.Desktop.Views.Onboarding.FinishStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
             Style="{StaticResource View.StepEntrance}">

    <Border Width="560"
            Padding="48,56"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource Surface.Card}">
        <StackPanel HorizontalAlignment="Center">
            <Border Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    Background="{StaticResource Brush.Primary}"
                    CornerRadius="{StaticResource Radius.Full}">
                <controls:LogoMark Width="30"
                                   Height="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.PrimaryForeground}" />
            </Border>

            <TextBlock Margin="0,28,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.Title}"
                       Text="Mercury is ready." />
            <TextBlock Margin="0,8,0,36"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.Muted}"
                       Text="Your workspace and first store have been created."
                       TextAlignment="Center" />

            <Button HorizontalAlignment="Center"
                    Command="{Binding GoToDashboardCommand}"
                    Content="Go to dashboard"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary.Lg}" />
        </StackPanel>
    </Border>
</UserControl>
