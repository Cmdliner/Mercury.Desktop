<Window x:Class="Mercury.Desktop.Views.DesignSystem.DesignSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
        xmlns:local="clr-namespace:Mercury.Desktop.Views.DesignSystem"
        Style="{StaticResource {x:Type Window}}"
        Title="Mercury design system"
        Width="1100"
        Height="900"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- A section heading: eyebrow, title and a short note. -->
        <Style x:Key="Section.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Section.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,0,0,28" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="Section.Divider" TargetType="Border" BasedOn="{StaticResource Surface.Divider}">
            <Setter Property="Margin" Value="0,56,0,48" />
        </Style>

        <Style x:Key="Sample.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <DataTemplate DataType="{x:Type local:Swatch}">
            <StackPanel Width="150" Margin="0,0,18,24">
                <Border Height="64"
                        Background="{Binding Brush}"
                        BorderBrush="{StaticResource Brush.BorderStrong}"
                        BorderThickness="1" />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource Text.Label}"
                           Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{Binding Hex}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageRoot" Margin="56,48,56,72" MaxWidth="1000">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <controls:LogoMark Width="28" Height="28" />
                <TextBlock Margin="10,0,0,2"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.SemiBold}"
                           FontSize="22"
                           Text="mercury" />
            </StackPanel>
            <TextBlock Margin="0,40,0,0" Style="{StaticResource Text.Eyebrow}" Text="DESIGN SYSTEM" />
            <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Display}" Text="Mercury for Windows" />
            <TextBlock Margin="0,12,0,0"
                       MaxWidth="640"
                       HorizontalAlignment="Left"
                       Style="{StaticResource Text.Lead}"
                       Text="The same design system as the website, in WPF. Every control below comes from Resources/Theme.xaml; reuse these styles instead of styling controls by hand." />

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Colour -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Colour" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="Every colour is a token in Resources/Tokens/Colors.xaml. Use the Brush.* key, never a hex value." />
            <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Typography -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Typography" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="Geist, embedded in the app. Each weight is its own font family, so styles pick a weight through the Font.* tokens." />
            <StackPanel>
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.DISPLAY · 40" />
                <TextBlock Margin="0,0,0,24" Style="{StaticResource Text.Display}" Text="One set of books." />
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.TITLE · 30" />
                <TextBlock Margin="0,0,0,24" Style="{StaticResource Text.Title}" Text="Tell us about your business" />
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.SUBTITLE · 24" />
                <TextBlock Margin="0,0,0,24" Style="{StaticResource Text.Subtitle}" Text="Every store gets its own books" />
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.HEADING · 18" />
                <TextBlock Margin="0,0,0,24" Style="{StaticResource Text.Heading}" Text="Account buckets" />
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.LEAD · 15" />
                <TextBlock Margin="0,0,0,24" MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Text.Lead}"
                           Text="Balances are derived from ledger entries, never typed in by hand." />
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.BODY · 14" />
                <TextBlock Margin="0,0,0,24" MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Text.Body}"
                           Text="Mercury gives each branch its own accounts and ledger, and brings them together so you can see balances at a glance." />
                <TextBlock Style="{StaticResource Sample.Caption}" Text="TEXT.LABEL · 13 / TEXT.CAPTION · 12 / TEXT.ERROR" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,24,0" Style="{StaticResource Text.Label}" Text="Business name" />
                    <TextBlock Margin="0,0,24,0" Style="{StaticResource Text.Caption}" Text="Helper text" />
                    <TextBlock Style="{StaticResource Text.Error}" Text="Enter a valid email address" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Buttons -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Buttons" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="Square corners, black and white. Primary is the default for every Button; pick another with Style=&quot;{StaticResource Button.Outline}&quot;. Add .Lg for the main action of a screen." />
            <StackPanel>
                <TextBlock Style="{StaticResource Sample.Caption}" Text="STANDARD · 40" />
                <WrapPanel Margin="0,0,0,28">
                    <Button Margin="0,0,12,12" Content="Primary" />
                    <Button Margin="0,0,12,12" Content="Outline" Style="{StaticResource Button.Outline}" />
                    <Button Margin="0,0,12,12" Content="Secondary" Style="{StaticResource Button.Secondary}" />
                    <Button Margin="0,0,12,12" Content="Ghost" Style="{StaticResource Button.Ghost}" />
                    <Button Margin="0,0,12,12" IsEnabled="False" Content="Disabled" />
                    <Button Margin="0,0,12,12" Style="{StaticResource Button.Icon}">
                        <controls:Icon Width="18" Height="18" Data="{StaticResource Icon.Close}" />
                    </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource Sample.Caption}" Text="LARGE · 48" />
                <WrapPanel>
                    <Button Margin="0,0,12,12" Content="Continue" Style="{StaticResource Button.Primary.Lg}" />
                    <Button Margin="0,0,12,12" Content="Back" Style="{StaticResource Button.Outline.Lg}" />
                    <Button Margin="0,0,12,12" Content="Skip for now" Style="{StaticResource Button.Ghost.Lg}" />
                    <Button Margin="0,0,12,12" Style="{StaticResource Button.Primary.Lg}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Go to dashboard" />
                            <controls:Icon Width="16" Height="16" Margin="10,0,0,0"
                                           Data="{StaticResource Icon.ArrowRight}"
                                           Foreground="{StaticResource Brush.PrimaryForeground}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Inputs -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Inputs" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="Wrap an input in controls:FormField for a label and its validation message. The message appears on its own when the bound view model reports an error." />
            <Grid DataContext="{Binding Form}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <controls:FormField Margin="0,0,0,20" Header="Empty, with placeholder">
                        <TextBox controls:InputHelper.Placeholder="Adeyemi Stores" />
                    </controls:FormField>
                    <controls:FormField Margin="0,0,0,20" Header="Filled">
                        <TextBox Text="Mercury Ikeja" />
                    </controls:FormField>
                    <controls:FormField Header="With an error">
                        <TextBox controls:InputHelper.Placeholder="owner@yourbusiness.ng"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FormField>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <controls:FormField Margin="0,0,0,20" Header="Password">
                        <PasswordBox controls:InputHelper.Placeholder="Create a password" />
                    </controls:FormField>
                    <controls:FormField Margin="0,0,0,20" Header="Dropdown">
                        <ComboBox controls:InputHelper.Placeholder="Select a bank">
                            <ComboBoxItem Content="Access Bank" />
                            <ComboBoxItem Content="GTBank" />
                            <ComboBoxItem Content="Zenith Bank" />
                        </ComboBox>
                    </controls:FormField>


                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,12" Text="Permissions" />
                    <CheckBox Margin="0,0,0,10" Content="View transactions" IsChecked="True" />
                    <CheckBox Margin="0,0,0,10" Content="Manage store accounts" IsChecked="True" />
                    <CheckBox Content="Invite staff" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Surfaces -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Surfaces and status" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="Depth comes from tone and a 1px border, never from shadows. Green is for success only; amber is for caution." />
            <StackPanel Orientation="Horizontal">
                <Border Width="320" Margin="0,0,24,0" Style="{StaticResource Surface.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="Mercury Ikeja" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource Text.Caption}" Text="Ikeja, Lagos" />
                        <TextBlock FontFamily="{StaticResource Font.SemiBold}" FontSize="24" Text="₦1,820,400" />
                        <Border Margin="0,16,0,0" Style="{StaticResource Pill.Success}">
                            <TextBlock Text="Active" />
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Top">
                    <Border Margin="0,0,0,12" Style="{StaticResource Pill.Success}">
                        <TextBlock Text="Reconciled" />
                    </Border>
                    <Border Style="{StaticResource Pill.Caution}">
                        <TextBlock Text="Under construction" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Workspace -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Workspace pieces" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="What the signed-in app is made of: sidebar navigation, stat cards, the avatar, window caption buttons and the slim scroll bar." />
            <StackPanel Orientation="Horizontal">
                <Border Width="240" Padding="16" Background="{StaticResource Brush.Card}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <ListBox ItemsSource="{Binding NavSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedIndex="0"
                             Style="{StaticResource ListBox.Navigation}" />
                </Border>
                <StackPanel Margin="32,0,0,0" Width="260">
                    <Border Padding="24" CornerRadius="{StaticResource Radius.Xl}" Style="{StaticResource Surface.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Total balance" />
                            <TextBlock Margin="0,14,0,14" Style="{StaticResource Text.Stat}"
                                       Text="₦4,820,400" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Across 3 stores" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Border Style="{StaticResource Surface.Avatar}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="AA" />
                        </Border>
                        <controls:WindowControls Margin="24,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Margin="32,0,0,0" Width="240" Height="200" VerticalScrollBarVisibility="Visible"
                              Background="{StaticResource Brush.Card}">
                    <StackPanel Margin="16">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                   Text="Scroll bars are a slim rounded thumb on a transparent track, with no arrows. They darken on hover and while dragged. Every scrolling area in the app uses this style, so there is nothing to apply. Keep scrolling to see the thumb move; this paragraph is only here to make the area taller than its frame, which is what makes a scroll bar appear in the first place." />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <Border Style="{StaticResource Section.Divider}" />

            <!-- Brand -->
            <TextBlock Style="{StaticResource Section.Title}" Text="Logo and icons" />
            <TextBlock Style="{StaticResource Section.Note}"
                       Text="The mark is flat and one colour. Use the foreground colour on light surfaces and white on dark ones." />
            <StackPanel Orientation="Horizontal">
                <Border Width="180" Height="120" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Background="{StaticResource Brush.Card}">
                    <controls:LogoMark Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="180" Height="120" Margin="16,0,0,0" Background="{StaticResource Brush.Sidebar}">
                    <controls:LogoMark Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.SidebarForeground}" />
                </Border>
                <StackPanel Margin="40,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <controls:Icon Margin="0,0,20,0" Width="24" Height="24" Data="{StaticResource Icon.Store}" />
                    <controls:Icon Margin="0,0,20,0" Width="24" Height="24" Data="{StaticResource Icon.Check}" />
                    <controls:Icon Margin="0,0,20,0" Width="24" Height="24" Data="{StaticResource Icon.ArrowRight}" />
                    <controls:Icon Margin="0,0,20,0" Width="24" Height="24" Data="{StaticResource Icon.ArrowLeft}" />
                    <controls:Icon Margin="0,0,20,0" Width="24" Height="24" Data="{StaticResource Icon.Eye}" />
                    <controls:Icon Margin="0,0,20,0" Width="24" Height="24" Data="{StaticResource Icon.ChevronDown}" />
                    <controls:Icon Width="24" Height="24" Data="{StaticResource Icon.Close}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
