<UserControl x:Class="Mercury.Desktop.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mercury.Desktop.Controls">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:LogoMark Width="44" Height="44" HorizontalAlignment="Center" />
        <TextBlock Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   Style="{StaticResource Text.Muted}"
                   Text="Opening Mercury..." />
    </StackPanel>
</UserControl>
