<Window x:Class="Mercury.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
        xmlns:login="clr-namespace:Mercury.Desktop.Views.Login"
        xmlns:loginVm="clr-namespace:Mercury.Desktop.ViewModels.Login"
        xmlns:onboarding="clr-namespace:Mercury.Desktop.Views.Onboarding"
        xmlns:onboardingVm="clr-namespace:Mercury.Desktop.ViewModels.Onboarding"
        xmlns:workspace="clr-namespace:Mercury.Desktop.Views.Workspace"
        xmlns:workspaceVm="clr-namespace:Mercury.Desktop.ViewModels.Workspace"
        Style="{StaticResource {x:Type Window}}"
        Title="Mercury"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <!-- The app draws its own title bar: the top 64px is the drag area, the edges resize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type loginVm:LoginViewModel}">
            <login:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type onboardingVm:OnboardingViewModel}">
            <onboarding:OnboardingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type workspaceVm:WorkspaceViewModel}">
            <workspace:WorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <!-- A maximised borderless window spills past the screen edge; RootFrame pads it back in. -->
    <Grid x:Name="RootFrame">
        <ContentControl Content="{Binding Current}" />
        <controls:WindowControls HorizontalAlignment="Right"
                                 VerticalAlignment="Top">
            <controls:WindowControls.Style>
                <Style TargetType="controls:WindowControls">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDarkCaptionArea}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.SidebarForeground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:WindowControls.Style>
        </controls:WindowControls>
    </Grid>
</Window>
