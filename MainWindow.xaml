<Window x:Class="Mercury.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mercury.Desktop.Controls"
        xmlns:views="clr-namespace:Mercury.Desktop.Views"
        xmlns:vm="clr-namespace:Mercury.Desktop.ViewModels"
        xmlns:login="clr-namespace:Mercury.Desktop.Views.Login"
        xmlns:loginVm="clr-namespace:Mercury.Desktop.ViewModels.Login"
        xmlns:onboarding="clr-namespace:Mercury.Desktop.Views.Onboarding"
        xmlns:onboardingVm="clr-namespace:Mercury.Desktop.ViewModels.Onboarding"
        xmlns:workspace="clr-namespace:Mercury.Desktop.Views.Workspace"
        xmlns:workspaceVm="clr-namespace:Mercury.Desktop.ViewModels.Workspace"
        Style="{StaticResource {x:Type Window}}"
        Title="Mercury"
        Icon="Resources/App.ico"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <!-- The app draws its own title bar: the top 44px is the drag area, the edges resize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SplashViewModel}">
            <views:SplashView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginVm:LoginViewModel}">
            <login:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginVm:AcceptInvitationViewModel}">
            <login:AcceptInvitationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type onboardingVm:OnboardingViewModel}">
            <onboarding:OnboardingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type workspaceVm:WorkspaceViewModel}">
            <workspace:WorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <!-- A maximised borderless window spills past the screen edge; RootFrame pads it back in. -->
    <Grid x:Name="RootFrame">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: near-black, with the brand on the left and the window buttons on the right. -->
        <Border Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.SidebarStep}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <controls:LogoMark Width="18" Height="18" Foreground="{StaticResource Brush.SidebarForeground}" />
                    <TextBlock Margin="9,0,0,1"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.SemiBold}"
                               FontSize="14"
                               Foreground="{StaticResource Brush.SidebarForeground}"
                               Text="mercury" />
                    <Border Width="1" Height="14" Margin="14,0,14,0" Background="{StaticResource Brush.SidebarStep}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Brush.SidebarMuted}"
                               Text="Finance for every store" />
                </StackPanel>

                <controls:WindowControls HorizontalAlignment="Right"
                                         VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Current}" />
    </Grid>
</Window>
